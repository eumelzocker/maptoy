      "forwardResponseHeaders": {
        "etag": "X-Maptoy-Upstream-ETag",
        "last-modified": "X-Maptoy-Upstream-Last-Modified"
      }
    },
    {
      "id": "OpenStreetMap",
      "enabled": true,
      "match": "^https://.*tile\\.openstreetmap\\.org/(?<z>\\d+)/(?<x>\\d+)/(?<y>\\d+)\\.png(?:\\?.*)?$",
      "target": "http://localhost:4004/api/map-sets/e2a0347f-556f-4689-8726-5357ea699d80/tiles/${z}/${x}/${y}",
      "forwardResponseHeaders": {
        "etag": "X-Maptoy-Upstream-ETag",
