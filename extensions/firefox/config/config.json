      }
    },
    {
      "id": "OpenTopoMap",
      "enabled": true,
      "match": "^https://.*tile\\.opentopomap\\.org/(?<z>\\d+)/(?<x>\\d+)/(?<y>\\d+)\\.png(?:\\?.*)?$",
