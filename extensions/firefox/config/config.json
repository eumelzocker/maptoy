      }
    },
    {
      "id": "WikiMap",
      "enabled": true,
      "match": "^https://maps\\.wikimedia\\.org/osm-intl/(?<z>\\d+)/(?<x>\\d+)/(?<y>\\d+)\\.png(?:\\?.*)?$",
