{
  "manifest_version": 3,
  "name": "maptoy-ff-ext",
  "version": "1.0.0",
  "description": "Forwards responses matching configured rules to a local API, unchanged and without a second fetch.",
  "browser_specific_settings": {
    "gecko": {
      "id": "maptoy-ff-ext@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_icon": "icon.svg",
    "default_title": "maptoy tile grabber"
  }
}
