meta {
  name: Tile Cache - Statistics (read only)
  type: http
  seq: 5
}

get {
  url: {{appUrl}}/api/map-sets/{{mapSetId}}/cache/stats
  body: none
  auth: none
}

tests {
  test("returns Tile Cache statistics", function() {
    expect(res.status).to.equal(200);
    expect(res.body.totalRevisionCount).to.be.a("number");
    expect(res.body.totalStorageBytes).to.be.a("number");
  });
}
