meta {
  name: Readiness
  type: http
  seq: 2
}

get {
  url: {{appUrl}}/api/ready
  body: none
  auth: none
}

docs {
  Checks the database plus the data directory and generated traffic-log subdirectories.

  ## Input

  No parameters, headers, or body.

  ## Response

  - `200 OK`: `status` = `ready`.
  - `503 Service Unavailable`: `status` = `not-ready` when a dependency is unavailable.
}

tests {
  test("is ready", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ready");
  });
}
