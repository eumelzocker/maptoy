meta {
  name: Tile Cache - Overall Statistics (read only)
  type: http
  seq: 9
}

get {
  url: {{appUrl}}/api/cache/stats
  body: none
  auth: none
}

docs {
  Returns metadata statistics across all Tile Caches without scanning files.

  ## Input

  No parameters, headers, or body.

  ## Response

  - `200 OK`: `mapSetCount`, `populatedMapSetCount`, aggregate `stats`, and per-Map-Set `mapSets`.
  - `stats` uses the same counters and per-zoom breakdown as the single-Map-Set statistics request.
}

tests {
  test("returns aggregate and per-Map-Set statistics", function() {
    expect(res.status).to.equal(200);
    expect(res.body.mapSetCount).to.be.a("number");
    expect(res.body.stats.totalRevisionCount).to.be.a("number");
    expect(res.body.mapSets).to.be.an("array");
  });
}
