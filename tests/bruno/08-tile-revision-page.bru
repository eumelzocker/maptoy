meta {
  name: Tile Cache - First Revision Page (read only)
  type: http
  seq: 8
}

get {
  url: {{appUrl}}/api/map-sets/{{mapSetId}}/tile-revisions?limit=50&state=all
  body: none
  auth: none
}

tests {
  test("returns a bounded revision page", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.at.most(50);
    expect(res.body.total).to.be.a("number");
  });
}
