meta {
  name: Tile Cache - First Revision Page (read only)
  type: http
  seq: 8
}

get {
  url: {{appUrl}}/api/map-sets/{{mapSetId}}/tile-revisions?limit=50&state=all
  body: none
  auth: none
}

params:query {
  limit: 50
  state: all
  ~cursor: replace-with-nextCursor
  ~zoom: 0
}

docs {
  Lists a bounded page of Tile revisions for one Map Set.

  ## Input

  - Path variable: `mapSetId` — existing Map Set UUID.
  - Query: `limit` = 1–200; this request uses `50`.
  - Query: `state` = `all`, `current`, or `historical`; this request uses `all`.
  - Optional query: `cursor` from the previous `nextCursor`; `zoom` = 0–24.
  - No headers or body.

  ## Response

  - `200 OK`: `items`, total matching the state/zoom filters, and nullable `nextCursor`.
  - Each item includes coordinate, content metadata, timestamps, `origin`, and `current`.

  ## Errors

  - `400 MAP_SET_INVALID`: invalid cursor or query value.
  - `404 MAP_SET_NOT_FOUND`.
}

tests {
  test("returns a bounded revision page", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.at.most(50);
    expect(res.body.total).to.be.a("number");
  });
}
