meta {
  name: Image Scan - Create Job (writes data)
  type: http
  seq: 17
}
post {
  url: {{appUrl}}/api/layers/{{imageLayerId}}/image-scan-jobs
  body: json
  auth: none
}

body:json {
  {
    "rootId": "{{imageRootId}}",
    "relativeDirectory": "",
    "recursive": true
  }
}

docs {
  Starts a persistent recursive scan for an existing Image Layer and configured read-only root.
}

tests {
  test("queues an image scan", function() {
    expect(res.status).to.equal(201);
    expect(res.body.type).to.equal("image-scan");
  });
}
