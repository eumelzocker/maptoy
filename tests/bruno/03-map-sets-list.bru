meta {
  name: Map Sets - List
  type: http
  seq: 3
}

get {
  url: {{appUrl}}/api/map-sets
  body: none
  auth: none
}

docs {
  Lists all configured Map Sets.

  ## Input

  No parameters, headers, or body.

  ## Response

  - `200 OK`: `items` contains complete Map Sets plus `logicalTileCount`.
}

tests {
  test("lists Map Sets", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}
