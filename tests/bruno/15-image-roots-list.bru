meta {
  name: Image Roots - List
  type: http
  seq: 15
}
get {
  url: {{appUrl}}/api/image-roots
  body: none
  auth: none
}

docs {
  Lists safe image-root IDs and availability. Absolute server paths are never returned.
}

tests {
  test("does not disclose image paths", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(JSON.stringify(res.body)).not.to.include("/images/");
  });
}
