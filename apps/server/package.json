{
  "name": "@maptoy/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@maptoy/config": "workspace:*",
    "@maptoy/contracts": "workspace:*",
    "@maptoy/image-layer": "workspace:*",
    "@maptoy/layer-plugin-sdk": "workspace:*",
    "@maptoy/leaflet-xyz": "workspace:*",
    "@maptoy/map-adapter-sdk": "workspace:*",
    "@maptoy/track-layer": "workspace:*",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
