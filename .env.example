# Server
MAPTOY_SERVER_HOST=0.0.0.0
MAPTOY_SERVER_PORT=4004

# Storage
MAPTOY_STORAGE_DATA_DIR=./.data

# Logging
MAPTOY_LOGGING_LEVEL=info
MAPTOY_LOGGING_DIR=${MAPTOY_STORAGE_DATA_DIR}/logs
MAPTOY_LOGGING_TRAFFIC_MAX_BYTES=10485760
MAPTOY_LOGGING_TRAFFIC_MAX_FILES=5

# Tiles
MAPTOY_TILES_ALLOW_PRIVATE_HOSTS=false
MAPTOY_TILES_PROVIDER_TIMEOUT_MS=10000
MAPTOY_TILES_MAX_BYTES=10485760

# Layers
MAPTOY_LAYERS_ASSET_MAX_BYTES=26214400

# Jobs
MAPTOY_JOBS_RETENTION_DAYS=30
MAPTOY_JOBS_ERROR_HISTORY_LIMIT=100

# Batch downloads
MAPTOY_DOWNLOADS_WARNING_TILE_COUNT=10000
MAPTOY_DOWNLOADS_MAX_TILE_COUNT=100000

# Photos
# Existing host directory mounted read-only into the container.
MAPTOY_PHOTOS_DIR=./.photos
MAPTOY_PHOTOS_MAX_FILE_BYTES=104857600
MAPTOY_PHOTOS_MAX_DECODED_PIXELS=100000000
MAPTOY_PHOTOS_PREVIEW_MAX_EDGE=640
MAPTOY_PHOTOS_SCAN_BATCH_SIZE=100
MAPTOY_PHOTOS_SCAN_CONCURRENCY=2
MAPTOY_PHOTOS_SCAN_MAX_FILES=100000

# Provider keys
# Secrets are referenced from Map Sets and are never stored in SQLite or shared with the frontend.
# Do NOT share secrets!
# Examples:
# MAPTOY_EXAMPLE_API_KEY=
# MAPTOY_API_KEY_RAPIDAPI=
# MAPTOY_API_KEY_MAPBOX=
# MAPTOY_API_KEY_MAPTILER=
# MAPTOY_API_KEY_THUNDERFOREST=
