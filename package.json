{
  "name": "maptoy",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter '!maptoy-ff-ext' -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "start": "pnpm build && pnpm --filter @maptoy/server start",
    "test": "vitest run",
    "typecheck": "pnpm --filter '!maptoy-ff-ext' -r --if-present typecheck",
    "ff-ext:build": "pnpm --filter maptoy-ff-ext build",
    "ff-ext:check": "pnpm --filter maptoy-ff-ext check",
    "ff-ext:lint": "pnpm --filter maptoy-ff-ext lint",
    "ff-ext:start": "pnpm --filter maptoy-ff-ext start",
    "ff-ext:test": "pnpm --filter maptoy-ff-ext test",
    "ff-ext:typecheck": "pnpm --filter maptoy-ff-ext typecheck",
    "d:down": "docker compose down",
    "d:up": "docker compose up --detach",
    "d:logs": "docker compose logs",
    "d:rebuild": "docker compose down && docker compose up --build --detach && docker compose ps && echo -n \"🚀 \" && date",
    "d:rebuild:all": "docker compose down && docker compose build --no-cache && docker compose up --detach --force-recreate --wait && docker compose ps && echo -n \"🚀🚀 \" && date"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "license": "WTFPL"
}
